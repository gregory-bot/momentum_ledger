# Everything is optional. With nothing set, the demo runs fully offline
# (template narrator in en/es/sw, local replay, in-memory ledger).

# Azure OpenAI / Microsoft Foundry deployment (leave the key empty to use Entra ID)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure AI Translator (unlocks fr, pt, ar, hi, yo, zh-Hans ...)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Azure Event Hubs (ingest) and Cosmos DB (ledger + overlays)
EVENTHUB_CONNECTION=
EVENTHUB_NAME=match-events
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=momentum

# Verifier: add an LLM judge on top of the deterministic checks
VERIFIER_LLM_JUDGE=false
# Demo: corrupt a share of first drafts so the trust panel shows real blocks (labelled in the UI)
DEMO_INJECT_FAULTS=true
DEMO_FAULT_RATE=0.15
MATCH_SEED=7
